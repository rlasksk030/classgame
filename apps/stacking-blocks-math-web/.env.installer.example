# TEST-only installer backend. Keep this file as a template; never put a PAT here.
INSTALLER_MODE=TEST
INSTALLER_ALLOWED_PROJECT_REFS=replace-with-test-project-ref
INSTALLER_ALLOWED_ORIGIN=https://your-static-app.example
INSTALLER_SESSION_SECRET=replace-with-at-least-32-random-characters
INSTALLER_PRODUCTION_REF=stacking-blocks-math
PORT=8787
HOST=0.0.0.0
INSTALLER_APP_ROOT=/path/to/stacking-blocks-math-web
# Optional: use a compatible Supabase Management API base URL in a test harness.
# SUPABASE_MANAGEMENT_API_URL=https://api.supabase.com

# Optional: enables OAuth-based Supabase connect (no PAT paste) for teachers.
# Requires a one-time OAuth App registration in the Supabase organization
# dashboard (Organization Settings -> OAuth Apps); this cannot be created via
# API. All three must be set together, or none at all (PAT path stays default).
# INSTALLER_OAUTH_CLIENT_ID=replace-after-registering-the-oauth-app
# INSTALLER_OAUTH_CLIENT_SECRET=replace-after-registering-the-oauth-app
# INSTALLER_OAUTH_REDIRECT_URI=https://your-installer-service.example/api/installer/oauth/callback
