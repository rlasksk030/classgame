# TEST-only installer backend. Keep this file as a template; never put a PAT here.
INSTALLER_MODE=TEST
INSTALLER_ALLOWED_PROJECT_REFS=replace-with-test-project-ref
INSTALLER_ALLOWED_ORIGIN=https://your-static-app.example
INSTALLER_SESSION_SECRET=replace-with-at-least-32-random-characters
INSTALLER_PRODUCTION_REF=stacking-blocks-math
PORT=8787
HOST=0.0.0.0
INSTALLER_APP_ROOT=/path/to/stacking-blocks-math-web
