# 브라우저에 노출되어도 되는 값만 VITE_ 접두사를 붙인다.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# 선택값: 교사별 배포판을 진단할 때 사용할 설치 식별자
VITE_INSTALLATION_ID=

# service_role key 와 세션 비밀키는 절대 여기에 넣지 않는다.
# 그 값들은 Supabase Edge Function Secrets 에만 둔다:
#   supabase secrets set APP_SESSION_SECRET=... 
