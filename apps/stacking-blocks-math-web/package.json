{
  "name": "stacking-blocks-math-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "초등 6학년 수학 '공간과 입체' - 3D 쌓기나무 학습 웹앱",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "inventory:problems": "node --experimental-strip-types scripts/generate-problem-inventory.ts",
    "audit:problems": "node --experimental-strip-types scripts/audit-problems.ts",
    "audit:presentation": "node --experimental-strip-types scripts/audit-presentation.ts",
    "audit:semantics": "node --experimental-strip-types scripts/audit-semantics.ts",
    "audit:solvability": "node --experimental-strip-types scripts/audit-solvability.ts",
    "oracle:verify": "node --experimental-strip-types scripts/oracle-cross-check.ts",
    "oracle:known-issues": "node --experimental-strip-types scripts/oracle-known-issues.ts",
    "qa:curriculum": "node --experimental-strip-types scripts/qa-curriculum.ts",
    "audit:lessons": "node --experimental-strip-types scripts/qa-curriculum.ts",
    "qa:local": "node --experimental-strip-types scripts/local-browser-qa.ts",
    "qa:visual": "playwright test e2e/visual.spec.ts",
    "qa:renderer": "playwright test e2e/renderer-mount.spec.ts",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "test:security": "deno test --allow-env=APP_SESSION_SECRET supabase/tests",
    "qa:test-connectivity": "node --experimental-strip-types scripts/verify-test-supabase.ts",
    "phase5b:test-remote": "node scripts/run-phase5b-test.mjs",
    "phase5b:test-schema": "node scripts/run-phase5b-test.mjs --schema-only",
    "phase5b:test-functions": "node scripts/run-phase5b-test.mjs --functions-only",
    "phase5b:test-fixtures": "node scripts/run-phase5b-test.mjs --fixtures-only",
    "qa:phase5b:remote": "node scripts/run-phase5b-test.mjs --e2e-only",
    "qa:phase5e:mock": "node --experimental-strip-types scripts/phase5b-runner.ts --mock",
    "qa:phase5b:probe": "node --experimental-strip-types scripts/phase5b-runner.ts --probe",
    "qa:phase5c:dry-run": "node scripts/run-phase5b-test.mjs --dry-run",
    "qa:installer:mock": "node --experimental-strip-types scripts/installer/qa-mock.ts",
    "installer:server": "node --experimental-strip-types scripts/installer/start.ts",
    "qa:installer:remote": "node --experimental-strip-types scripts/installer/qa-remote.ts",
    "typecheck:edge": "deno check supabase/functions/student-api/index.ts supabase/functions/student-auth/index.ts",
    "qa:redesign": "node scripts/run-redesign-qa.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^8.0.0",
    "@supabase/supabase-js": "^2.45.4",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "deno": "^2.9.6",
    "eslint": "^10.10.0",
    "supabase": "^2.117.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.5"
  }
}
